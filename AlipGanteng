local function mk(cls, parent, props)
    local o = Instance.new(cls)
    if props then
        for k, v in pairs(props) do
            o[k] = v
        end
    end
    o.Parent = parent
    return o
end

local function corner(inst, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = inst
    return c
end

local function stroke(inst, col, th, trans)
    local s = Instance.new("UIStroke")
    s.Color = col or Color3.fromRGB(255, 255, 255)
    s.Thickness = th or 1
    s.Transparency = trans or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = inst
    return s
end

-- pinggiran RAINBOW berjalan
local function rainbow(inst)
    local g = Instance.new("UIGradient")
    g.Color = RAINBOW
    g.Rotation = 0
    g.Parent = inst
    task.spawn(function()
        while inst.Parent and not DESTROYED do
            pcall(function() g.Rotation = (os.clock() * 130) % 360 end)
            task.wait(0.03)
        end
    end)
    return g
end

-- drag window (mouse + touch / Android)
local function makeDrag(frame, handle, moveFlag)
    local dragging, dragStart, startPos = false, nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging   = true
            dragStart  = input.Position
            startPos   = frame.Position
            if moveFlag then moveFlag.moved = false end
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            if moveFlag and (math.abs(d.X) > 6 or math.abs(d.Y) > 6) then
                moveFlag.moved = true
            end
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
end

