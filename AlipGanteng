--// LIPZY HUB - UPDATE GUI
--// UI ONLY

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "LipzyHub"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

--// Window
local window = Instance.new("Frame")
window.Size = UDim2.fromOffset(360, 220)
window.Position = UDim2.fromScale(0.5, 0.5)
window.AnchorPoint = Vector2.new(0.5, 0.5)
window.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
window.BorderSizePixel = 0
window.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 18)
corner.Parent = window

local stroke = Instance.new("UIStroke")
stroke.Thickness = 2
stroke.Parent = window

--// Rainbow animation
local hue = 0

task.spawn(function()
	while gui.Parent do
		hue = (hue + 0.005) % 1
		local color = Color3.fromHSV(hue, 1, 1)

		stroke.Color = color

		task.wait(0.03)
	end
end)

--// LIPZY HUB
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 65)
title.Position = UDim2.fromOffset(0, 15)
title.BackgroundTransparency = 1
title.Text = "LIPZY HUB"
title.TextScaled = true
title.Font = Enum.Font.GothamBlack
title.Parent = window

--// Rainbow title
task.spawn(function()
	local h = 0

	while title.Parent do
		h = (h + 0.01) % 1
		title.TextColor3 = Color3.fromHSV(h, 1, 1)
		task.wait(0.03)
	end
end)

--// UPDATE
local update = Instance.new("TextLabel")
update.Size = UDim2.new(1, -40, 0, 70)
update.Position = UDim2.fromOffset(20, 90)
update.BackgroundTransparency = 1
update.Text = "⚙️ UPDATE ⚙️"
update.TextScaled = true
update.Font = Enum.Font.GothamBold
update.Parent = window

--// Rainbow + blinking animation
task.spawn(function()
	local h = 0

	while update.Parent do
		h = (h + 0.015) % 1
		update.TextColor3 = Color3.fromHSV(h, 1, 1)

		update.TextTransparency = 0
		task.wait(0.35)

		update.TextTransparency = 0.65
		task.wait(0.15)

		update.TextTransparency = 0
		task.wait(0.35)
	end
end)

