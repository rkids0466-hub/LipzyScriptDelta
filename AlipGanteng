local function canFS()
    return type(readfile) == "function" and type(writefile) == "function"
end

local function readSave()
    if not canFS() then return {} end
    local ok, res = pcall(function()
        if type(isfile) == "function" and not isfile(CFG.SAVE_FILE) then return nil end
        return readfile(CFG.SAVE_FILE)
    end)
    if not ok or type(res) ~= "string" or res == "" then return {} end
    local ok2, tbl = pcall(function() return HttpS:JSONDecode(res) end)
    if ok2 and type(tbl) == "table" then return tbl end
    return {}
end

local function writeSave(tbl)
    if not canFS() then return end
    pcall(function() writefile(CFG.SAVE_FILE, HttpS:JSONEncode(tbl)) end)
end

