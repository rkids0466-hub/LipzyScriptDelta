    pcall(function() if type(gethwid) == "function" then id = gethwid() end end)
    if type(id) ~= "string" or id == "" then
        pcall(function() id = game:GetService("RbxAnalyticsService"):GetClientId() end)
    end
    if type(id) ~= "string" or id == "" then
        pcall(function() id = tostring(LP.UserId) .. "-" .. tostring(LP.Name) end)
    end
    return tostring(id or "UNKNOWN-DEVICE")
end

