    local ChatScroll = Instance.new("ScrollingFrame")
    ChatScroll.Size = UDim2.new(1, 0, 0, 140)
    ChatScroll.Position = UDim2.new(0, 0, 0, 30)
    ChatScroll.BackgroundTransparency = 1
    ChatScroll.BorderSizePixel = 0
    ChatScroll.ScrollBarThickness = 6
    ChatScroll.Parent = AdminContent

    local ChatListLayout = Instance.new("UIListLayout")
    ChatListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    ChatListLayout.Padding = UDim.new(0, 6)
    ChatListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ChatListLayout.Parent = ChatScroll

    local MessageInput = Instance.new("TextBox")
    MessageInput.Size = UDim2.new(0, 370, 0, 40)
    MessageInput.Position = UDim2.new(0, 0, 0, 180)
    MessageInput.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
    MessageInput.PlaceholderText = "Tulis Pesan...."
    MessageInput.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
    MessageInput.Text = ""
    MessageInput.TextColor3 = Color3.fromRGB(0, 0, 0)
    MessageInput.Font = Enum.Font.FredokaOne
    MessageInput.TextSize = 18
    MessageInput.Parent = AdminContent

    local InputCorner = Instance.new("UICorner")
    InputCorner.CornerRadius = UDim.new(0, 12)
    InputCorner.Parent = MessageInput

    local SendBtn = Instance.new("TextButton")
    SendBtn.Size = UDim2.new(0, 125, 0, 40)
    SendBtn.Position = UDim2.new(0, 385, 0, 180)
    SendBtn.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
    SendBtn.Text = "SEND"
    SendBtn.TextColor3 = Color3.fromRGB(130, 0, 255)
    SendBtn.Font = Enum.Font.FredokaOne
    SendBtn.TextSize = 22
    SendBtn.Parent = AdminContent

    local SendBtnCorner = Instance.new("UICorner")
    SendBtnCorner.CornerRadius = UDim.new(0, 12)
    SendBtnCorner.Parent = SendBtn

    local isAdminUser = (LocalPlayer.Name == "LifzxAfter2")
    if not isAdminUser then
        MessageInput.TextEditable = false
        MessageInput.PlaceholderText = "Hanya LifzxAfter2 yang bisa chat"
        SendBtn.Active = false
        SendBtn.AutoButtonColor = false
        SendBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    end

    local function addChatMessage(msgText)
        local MsgLabel = Instance.new("TextLabel")
        MsgLabel.Size = UDim2.new(1, -10, 0, 28)
        MsgLabel.BackgroundTransparency = 1
        MsgLabel.Font = Enum.Font.FredokaOne
        MsgLabel.Text = "  Lipzy Hub: " .. msgText
        MsgLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        MsgLabel.TextSize = 18
        MsgLabel.TextXAlignment = Enum.TextXAlignment.Left
        MsgLabel.Parent = ChatScroll

        local Stroke = Instance.new("UIStroke")
        Stroke.Color = Color3.fromRGB(255, 0, 0)
        Stroke.Thickness = 1.5
        Stroke.Parent = MsgLabel

        ChatScroll.CanvasSize = UDim2.new(0, 0, 0, ChatListLayout.AbsoluteContentSize.Y + 10)
        ChatScroll.CanvasPosition = Vector2.new(0, ChatScroll.AbsoluteWindowSize.Y + 9999)

        if not AdminContent.Visible then
            unreadCount = unreadCount + 1
            NotifBadgeText.Text = tostring(unreadCount)
            AdminNotifBadge.Visible = true
        end
    end

    local TopicName = "LipzyHub_AdminChat_Global"
    pcall(function()
        MessagingService:SubscribeAsync(TopicName, function(messageData)
            local msg = messageData.Data
            if typeof(msg) == "string" then
                addChatMessage(msg)
            end
        end)
    end)

    local ChatEvent = ReplicatedStorage:FindFirstChild("LipzyHubChatEvent")
    if not ChatEvent then
        ChatEvent = Instance.new("BindableEvent")
        ChatEvent.Name = "LipzyHubChatEvent"
        ChatEvent.Parent = ReplicatedStorage
    end

    ChatEvent.Event:Connect(function(msg)
        addChatMessage(msg)
    end)

    local function sendMessage()
        if not isAdminUser then return end
        local text = MessageInput.Text
        if text:gsub("%s+", "") ~= "" then
            MessageInput.Text = ""
            pcall(function()
                MessagingService:PublishAsync(TopicName, text)
            end)
            ChatEvent:Fire(text)
        end
    end

    SendBtn.MouseButton1Click:Connect(sendMessage)
    MessageInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            sendMessage()
        end
    end)

    ScriptTabBtn.MouseButton1Click:Connect(function()
        ScriptContent.Visible = true
        PrediksiContent.Visible = false
        AdminContent.Visible = false
    end)

    PrediksiTabBtn.MouseButton1Click:Connect(function()
        ScriptContent.Visible = false
        PrediksiContent.Visible = true
        AdminContent.Visible = false
    end)

    AdminTabBtn.MouseButton1Click:Connect(function()
        ScriptContent.Visible = false
        PrediksiContent.Visible = false
        AdminContent.Visible = true
        
        unreadCount = 0
        AdminNotifBadge.Visible = false
    end)

    -- TEXT TYPING
    local TypingLabel = Instance.new("TextLabel")  
    TypingLabel.Size = UDim2.new(0, 400, 0, 30)  
    TypingLabel.Position = UDim2.new(0.5, -200, 0.9, -5)  
    TypingLabel.BackgroundTransparency = 1  
    TypingLabel.Font = Enum.Font.FredokaOne  
    TypingLabel.TextSize = 22  
    TypingLabel.TextColor3 = Color3.fromRGB(255, 255, 255)  
    TypingLabel.Text = ""  
    TypingLabel.Parent = MainFrame  

    task.spawn(function()  
        local fullText = "LIPZY HUB V 3.4"  
        while MainFrame and MainFrame.Parent do  
            for i = 1, #fullText do  
                TypingLabel.Text = string.sub(fullText, 1, i)  
                task.wait(0.12)  
            end  
            task.wait(1.5)  
            for i = #fullText, 0, -1 do  
                TypingLabel.Text = string.sub(fullText, 1, i)  
                task.wait(0.08)  
            end  
            task.wait(0.5)  
        end  
    end)  
end

