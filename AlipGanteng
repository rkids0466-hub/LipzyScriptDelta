--=====================================================================
local function cleanKey(raw)
    local s = tostring(raw or "")
    s = s:gsub("%s+", "")
    return s:upper()
end

local function fmtTime(sec)
    if sec < 0 then sec = 0 end
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = math.floor(sec % 60)
    return string.format("%02d:%02d:%02d", h, m, s)
end

-- cek binding global (optional)
local function remoteHolder(key)
    if CFG.REMOTE_KEYDB == "" then return nil end
    local ok, res = pcall(function()
        local body = game:HttpGet(CFG.REMOTE_KEYDB)
        return HttpS:JSONDecode(body)
    end)
    if ok and type(res) == "table" then
        return res[key] -- nil kalau key belum ada di database
    end
    return nil
end

-- return : true, "premium"/"free"   |   false, pesanError
local function validateKey(raw)
    local key = cleanKey(raw)
    if key == "" then
        return false, TXT_INVALID .. "\nKey masih kosong, isi dulu ya!"
    end

    -- ============ KEY PREMIUM (PERMANEN) ============
    if PREMIUM_KEYS[key] then
        local holder = DATA.bound[key]
        if holder and holder ~= HWID then
            return false, TXT_INVALID .. "\n(Key ini sudah dipakai & terkunci di Android lain)"
        end
        local rh = remoteHolder(key)
        if rh and tostring(rh) ~= HWID then
            return false, TXT_INVALID .. "\n(Key ini sudah terdaftar di device lain)"
        end

        DATA.bound[key]  = HWID
        DATA.premium     = { key = key, device = HWID, since = os.time() }
        DATA.free        = nil
        writeSave(DATA)

        STATE.kind, STATE.key, STATE.expire = "premium", key, 0
        return true, "premium"
    end

    -- ============ KEY FREE (3 JAM) ============
    if FREE_KEYS[key] then
        DATA.free         = { key = key, device = HWID, expire = os.time() + CFG.FREE_TIME }
        DATA.bound[key]   = HWID
        writeSave(DATA)

        STATE.kind   = "free"
        STATE.key    = key
        STATE.expire = DATA.free.expire
        return true, "free"
    end

    return false, TXT_INVALID .. "\n(Key salah / bukan key LIPZY HUB)"
end

-- cek key yang sudah tersimpan -> kalau ada, TIDAK perlu input key lagi
local function loadSavedKey()
    -- premium permanen
    if type(DATA.premium) == "table" and DATA.premium.key and DATA.premium.device == HWID then
        if PREMIUM_KEYS[DATA.premium.key] then
            STATE.kind, STATE.key, STATE.expire = "premium", DATA.premium.key, 0
            return true
        end
    end
    -- free masih aktif
    if type(DATA.free) == "table" and DATA.free.key and DATA.free.device == HWID then
        if FREE_KEYS[DATA.free.key] and (DATA.free.expire or 0) > os.time() then
            STATE.kind, STATE.key, STATE.expire = "free", DATA.free.key, DATA.free.expire
            return true
        end
        DATA.free = nil
        writeSave(DATA)
    end
    return false
end

