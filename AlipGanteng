local function isKeySaved()
    if isfile and readfile then
        if isfile(KeyFileName) then
            local savedKey = readfile(KeyFileName)
            return savedKey == CorrectKey
        end
    end
    return false
end

local function saveKey(key)
    if writefile then
        writefile(KeyFileName, key)
    end
end

