--=========================== TOMBOL CONTINUE ==========================
local checking = false

local function doContinue()
    if checking then return end
    checking = true
    continueBtn.Text = "CHECKING..."

    task.spawn(function()
        task.wait(0.35)
        local ok, res = validateKey(keyBox.Text)

        if ok then
            statusLbl.Text = TXT_VALID
            statusLbl.TextColor3 = Color3.fromRGB(110, 255, 150)
            keyBox.Text = ""
            showHubPage()  -- PINDAH JENDELA KE MENU HUB
            if res == "premium" then
                toast("\226\156\148 KEY PREMIUM PERMANEN aktif di Android ini!", 5)
                notify("LIPZY HUB", "KEY PREMIUM PERMANEN aktif \226\156\148", 5)
            else
                toast("\226\156\148 KEY FREE aktif 3 jam (sisa " .. fmtTime(STATE.expire - os.time()) .. ")", 5)
                notify("LIPZY HUB", "KEY FREE aktif 3 jam \226\156\148", 5)
            end
        else
            statusLbl.Text = tostring(res)
            statusLbl.TextColor3 = Color3.fromRGB(255, 90, 90)
            -- efek goyang
            task.spawn(function()
                for _ = 1, 3 do
                    TweenS:Create(main, TweenInfo.new(0.05), { Rotation = 2 }):Play()
                    task.wait(0.06)
                    TweenS:Create(main, TweenInfo.new(0.05), { Rotation = -2 }):Play()
                    task.wait(0.06)
                end
                TweenS:Create(main, TweenInfo.new(0.08), { Rotation = 0 }):Play()
            end)
        end

        continueBtn.Text = "CONTINUE"
        checking = false
    end)
end

continueBtn.MouseButton1Click:Connect(doContinue)

keyBox.FocusLost:Connect(function(enter)
    if enter then
        doContinue()  -- tekan ENTER di keyboard = sama seperti tekan CONTINUE
    end
end)

