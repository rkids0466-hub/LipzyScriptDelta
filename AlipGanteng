local hubButtons = {}

local function setButtonState(btn, txt, col)
    local lbl = btn:FindFirstChild("HubName")
    if lbl then lbl.Text = txt end
    if col then
        TweenS:Create(btn, TweenInfo.new(0.2), { BackgroundColor3 = col }):Play()
    end
end

local function runHub(hub, btn)
    if genv.LipzyHubExecuting then
        toast("Tunggu sebentar, script lain masih di-load...", 3)
        return
    end
    genv.LipzyHubExecuting = true
    setButtonState(btn, "\226\143\179  LOADING " .. hub.name .. " ...", Color3.fromRGB(70, 70, 110))
    toast("Loading " .. hub.name .. " ...", 3)
    notify("LIPZY HUB", "Loading " .. hub.name .. " ...", 3)

    task.spawn(function()
        local snippet = 'loadstring(game:HttpGet("' .. hub.url .. '"))()'
        local ok, err = pcall(function()
            local fn = (loadstring or load)(snippet)
            if type(fn) ~= "function" then
                error("Gagal compile loadstring (" .. hub.name .. ")")
            end
            fn()
        end)

        genv.LipzyHubExecuting = false
        setButtonState(btn, hub.name, Color3.fromRGB(38, 38, 58))

        if ok then
            toast("\226\156\148 " .. hub.name .. " BERHASIL DILOAD!", 4)
            notify("LIPZY HUB", hub.name .. " loaded \226\156\148", 4)
        else
            toast("\226\156\150 GAGAL : " .. tostring(err), 6)
            notify("LIPZY HUB ERROR", tostring(err), 6)
        end
    end)
end

