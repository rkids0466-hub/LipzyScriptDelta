local toastToken = 0
local function toast(text, dur)
    toastToken = toastToken + 1
    local myToken = toastToken
    toastLabel.Text = tostring(text)
    toastFrame.Visible = true
    toastFrame.BackgroundTransparency = 0
    toastLabel.TextTransparency = 0
    task.spawn(function()
        local t = 0
        while t < (dur or 4) do
            task.wait(0.1)
            t = t + 0.1
            if myToken ~= toastToken then return end
        end
        TweenS:Create(toastFrame, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
        TweenS:Create(toastLabel, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
        task.wait(0.45)
        if myToken == toastToken then
            toastFrame.Visible = false
        end
    end)
end

