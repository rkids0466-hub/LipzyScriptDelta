    UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center  
    UIListLayout.Padding = UDim.new(0, 8)  
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder  
    UIListLayout.Parent = ScrollFrame  

    -- Generasi Tombol Hub  
    for i, hubData in ipairs(HubList) do  
        local HubBtn = Instance.new("TextButton")  
        HubBtn.Name = hubData.Name  
        HubBtn.Size = UDim2.new(0, 580, 0, 34)  
        HubBtn.BackgroundColor3 = Color3.fromRGB(240, 240, 240)  
        HubBtn.Text = hubData.Name  
        HubBtn.TextColor3 = Color3.fromRGB(130, 0, 255)  
        HubBtn.Font = Enum.Font.FredokaOne  
        HubBtn.TextSize = 20  
        HubBtn.LayoutOrder = i  
        HubBtn.Parent = ScrollFrame  

        local BtnCorner = Instance.new("UICorner")  
        BtnCorner.CornerRadius = UDim.new(0, 15)  
        BtnCorner.Parent = HubBtn  

        -- Klik Tombol: Hapus Lipzy Hub dan Jalankan Script Hub  
        HubBtn.MouseButton1Click:Connect(function()  
            BackgroundSound:Stop()
            BackgroundSound:Destroy()
            ScreenGui:Destroy()  
            pcall(function()  
                loadstring(game:HttpGet(hubData.Script:match('https://[^"]+')))()  
            end)  
        end)  
    end  

    -- Text Animasi Mengetik di Bagian Bawah "LIPZY HUB V 3.4"  
    local TypingLabel = Instance.new("TextLabel")  
    TypingLabel.Size = UDim2.new(0, 400, 0, 30)  
    TypingLabel.Position = UDim2.new(0.5, -200, 0.9, -5)  
    TypingLabel.BackgroundTransparency = 1  
    TypingLabel.Font = Enum.Font.FredokaOne  
    TypingLabel.TextSize = 22  
    TypingLabel.TextColor3 = Color3.fromRGB(255, 255, 255)  
    TypingLabel.Text = ""  
    TypingLabel.Parent = MainFrame  

    task.spawn(function()  
        local fullText = "LIPZY HUB V 3.4"  
        while MainFrame and MainFrame.Parent do  
            for i = 1, #fullText do  
                TypingLabel.Text = string.sub(fullText, 1, i)  
                task.wait(0.12)  
            end  
            task.wait(1.5)  
            for i = #fullText, 0, -1 do  
                TypingLabel.Text = string.sub(fullText, 1, i)  
                task.wait(0.08)  
            end  
            task.wait(0.5)  
        end  
    end)  
end

