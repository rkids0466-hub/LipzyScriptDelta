local function toggleFps15(enabled)
    Fps15Enabled = enabled
    if enabled then
        if Fps15Connection then
            Fps15Connection:Disconnect()
        end
        Fps15Connection = RunService.Heartbeat:Connect(function()
            task.wait(1/15)
        end)
    else
        if Fps15Connection then
            Fps15Connection:Disconnect()
            Fps15Connection = nil
        end
    end
end

