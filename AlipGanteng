            local mousePos = input.Position.X
            local sliderPos = VolSliderBg.AbsolutePosition.X
            local sliderWidth = VolSliderBg.AbsoluteSize.X
            local scale = math.clamp((mousePos - sliderPos) / sliderWidth, 0, 1)
            VolSliderFill.Size = UDim2.new(scale, 0, 1, 0)
            BackgroundSound.Volume = scale
            VolLabel.Text = "VOL: " .. math.floor(scale * 100) .. "%"
